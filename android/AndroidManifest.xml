<?xml version="1.0" encoding="utf-8"?>
<!-- AndroidManifest.xml: mmcfm as a native SDL app (no Gradle, no Flutter).
     build.sh links this with aapt2; the version code/name come from build.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.mmc.filemanager"
    android:installLocation="auto">

    <!-- Android 11+: one "All files access" grant covers every folder. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Android 6..10 (and 11+ before the grant above). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Android 13+ media read access (thumbnails, players) without all-files access. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Online videos, photos and audio (src/fnet.c through FmNet.java). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To send every request over the current default network (FmNet.java). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature android:glEsVersion="0x00020000" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:extractNativeLibs="false"
        android:resizeableActivity="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".FmActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode|layoutDirection|locale|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_FILES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Hands files to other apps (open with / share) as content:// URIs. -->
        <provider
            android:name=".FmFileProvider"
            android:authorities="io.github.mmc.filemanager.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
